{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "resource-guardrails chart values",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "policies": {
      "type": "array",
      "description": "Admission policies to render. The default values file ships with namespace and secret protection policies, but ops can disable them or add more entries here.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "fullnameOverride": {
            "type": "string"
          },
          "bindingName": {
            "type": "string"
          },
          "policy": {
            "type": "object",
            "properties": {
              "metadata": {
                "type": "object",
                "additionalProperties": true
              },
              "spec": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "binding": {
            "type": "object",
            "properties": {
              "metadata": {
                "type": "object",
                "additionalProperties": true
              },
              "spec": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
